<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>互動單字卡 Flashcards</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .perspective-1000 {
            perspective: 1000px;
        }
        .transform-style-3d {
            transform-style: preserve-3d;
        }
        .backface-hidden {
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        .rotate-y-180 {
            transform: rotateY(180deg);
        }
        /* Custom scrollbar for cards container */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col font-sans">

    <!-- Header / Navbar -->
    <header class="bg-indigo-600 text-white shadow-md">
        <div class="max-w-5xl mx-auto px-4 py-4 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <i class="fa-solid me-2 fa-brain text-2xl text-amber-300"></i>
                <h1 class="text-xl font-bold tracking-wide">互動單字卡 Flashcards</h1>
            </div>
            
            <div class="flex items-center space-x-2 sm:space-x-3">
                <button id="btn-practice-mode" class="bg-indigo-700 hover:bg-indigo-800 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1 shadow-sm">
                    <i class="fa-solid fa-layer-group"></i>
                    <span>卡片模式</span>
                </button>
                <button id="btn-list-mode" class="bg-indigo-500/50 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1">
                    <i class="fa-solid fa-list"></i>
                    <span>列表管理</span>
                </button>
                <button id="btn-add-card" class="bg-amber-400 hover:bg-amber-300 text-indigo-950 font-semibold px-3 py-1.5 rounded-lg text-sm transition flex items-center space-x-1 shadow-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>新增單字</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-5xl w-full mx-auto px-4 py-6 flex flex-col">

        <!-- Control Bar (Filter & Search) -->
        <section class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap items-center gap-3 w-full sm:w-auto">
                <!-- Search Box -->
                <div class="relative flex-1 sm:w-64">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="search-input" placeholder="搜尋單字、中譯或例句..." class="w-full pl-9 pr-3 py-1.5 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition">
                </div>

                <!-- Status Filter -->
                <select id="filter-status" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="all">所有狀態 (全數)</option>
                    <option value="review">需複習 ⚡</option>
                    <option value="mastered">已掌握 ✨</option>
                </select>

                <!-- Category Filter -->
                <select id="filter-category" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="all">所有分類</option>
                </select>
            </div>

            <!-- Import/Export Tools -->
            <div class="flex items-center space-x-2 text-xs text-slate-500 w-full sm:w-auto justify-end">
                <button id="btn-export" class="hover:text-indigo-600 px-2 py-1 border border-slate-200 rounded hover:border-indigo-300 transition flex items-center space-x-1">
                    <i class="fa-solid fa-download"></i>
                    <span>匯出備份</span>
                </button>
                <label id="btn-import-label" class="hover:text-indigo-600 px-2 py-1 border border-slate-200 rounded hover:border-indigo-300 transition cursor-pointer flex items-center space-x-1">
                    <i class="fa-solid fa-upload"></i>
                    <span>匯入單字</span>
                    <input type="file" id="import-file" accept=".json" class="hidden">
                </label>
            </div>
        </section>

        <!-- VIEW 1: Flashcard Practice View -->
        <section id="view-practice" class="flex-1 flex flex-col items-center justify-center min-h-[400px]">
            
            <!-- Progress Bar & Indicator -->
            <div class="w-full max-w-md mb-4 flex items-center justify-between text-sm text-slate-500 font-medium px-1">
                <span id="card-counter">1 / 10</span>
                <div class="w-1/2 bg-slate-200 h-2 rounded-full overflow-hidden">
                    <div id="progress-bar" class="bg-indigo-600 h-full transition-all duration-300" style="width: 10%;"></div>
                </div>
                <span id="card-status-badge" class="px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-800">需複習</span>
            </div>

            <!-- Flashcard Container -->
            <div class="w-full max-w-md h-80 perspective-1000 cursor-pointer select-none group" id="flashcard">
                <div id="flashcard-inner" class="relative w-full h-full duration-500 transform-style-3d shadow-xl rounded-2xl border border-slate-100">
                    
                    <!-- FRONT SIDE -->
                    <div class="absolute w-full h-full backface-hidden bg-white rounded-2xl p-6 flex flex-col justify-between border-2 border-indigo-100 group-hover:border-indigo-300 transition">
                        <div class="flex justify-between items-start">
                            <span id="card-category-front" class="bg-indigo-50 text-indigo-600 text-xs font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                                General
                            </span>
                            <button id="btn-speak-word" title="播放發音" class="text-slate-400 hover:text-indigo-600 p-2 rounded-full hover:bg-indigo-50 transition">
                                <i class="fa-solid fa-volume-high text-lg"></i>
                            </button>
                        </div>

                        <div class="text-center my-auto">
                            <h2 id="card-word" class="text-3xl font-extrabold text-slate-800 mb-2">
                                Vocabulary
                            </h2>
                            <span id="card-pos" class="text-sm italic text-indigo-500 font-serif">
                                n.
                            </span>
                        </div>

                        <div class="text-center text-xs text-slate-400 flex items-center justify-center space-x-1">
                            <i class="fa-solid fa-rotate"></i>
                            <span>點擊卡片或按 Space 鍵翻面查看解釋</span>
                        </div>
                    </div>

                    <!-- BACK SIDE -->
                    <div class="absolute w-full h-full backface-hidden rotate-y-180 bg-gradient-to-br from-indigo-900 to-indigo-800 text-white rounded-2xl p-6 flex flex-col justify-between shadow-2xl">
                        <div class="flex justify-between items-start border-b border-indigo-700/60 pb-2">
                            <span id="card-pos-back" class="bg-indigo-700/80 text-indigo-200 text-xs px-2 py-0.5 rounded font-serif italic">
                                n.
                            </span>
                            <button id="btn-speak-example" title="朗讀例句" class="text-indigo-200 hover:text-amber-300 p-1.5 rounded-full hover:bg-indigo-700/50 transition">
                                <i class="fa-solid fa-volume-high text-base"></i>
                            </button>
                        </div>

                        <div class="my-auto space-y-3">
                            <div id="card-translation" class="text-2xl font-bold text-amber-300 text-center">
                                單字中譯說明
                            </div>

                            <div class="bg-indigo-950/40 p-3 rounded-lg border border-indigo-700/40">
                                <p id="card-example" class="text-sm text-slate-100 font-light leading-relaxed mb-1 italic">
                                    "This is an example sentence showing how the word is used."
                                </p>
                                <p id="card-example-trans" class="text-xs text-indigo-200">
                                    「這是一個例句，展示該單字的使用方式。」
                                </p>
                            </div>
                        </div>

                        <div class="flex justify-between items-center text-xs text-indigo-300 pt-2 border-t border-indigo-700/60">
                            <span id="card-category-back">General</span>
                            <span>點擊翻回正面</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Controls (Navigation & Mastery) -->
            <div class="w-full max-w-md mt-6 flex items-center justify-between gap-2">
                <button id="btn-prev" class="flex-1 bg-white hover:bg-slate-100 text-slate-700 border border-slate-200 py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center justify-center space-x-1">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>上一張</span>
                </button>

                <button id="btn-toggle-mastered" class="px-4 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-xl text-sm font-semibold transition flex items-center space-x-1.5 shadow-sm">
                    <i id="mastered-icon" class="fa-regular fa-circle-check text-base"></i>
                    <span id="mastered-text">已掌握</span>
                </button>

                <button id="btn-next" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white py-2.5 rounded-xl text-sm font-semibold shadow-sm transition flex items-center justify-center space-x-1">
                    <span>下一張</span>
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>

            <!-- Empty State -->
            <div id="empty-state-practice" class="hidden text-center py-12 px-4">
                <i class="fa-solid fa-box-open text-4xl text-slate-300 mb-3"></i>
                <p class="text-slate-600 font-medium">沒有符合條件的單字卡</p>
                <p class="text-xs text-slate-400 mt-1">請嘗試變更篩選條件或新增單字卡。</p>
            </div>

        </section>

        <!-- VIEW 2: Word List Management View -->
        <section id="view-list" class="hidden flex-1 flex-col">
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden flex-1 flex flex-col">
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-semibold text-xs uppercase tracking-wider">
                            <tr>
                                <th class="p-3.5">狀態</th>
                                <th class="p-3.5">單字 (詞性)</th>
                                <th class="p-3.5">中文翻譯</th>
                                <th class="p-3.5">分類</th>
                                <th class="p-3.5 hidden md:table-cell">例句</th>
                                <th class="p-3.5 text-right">操作</th>
                            </tr>
                        </thead>
                        <tbody id="words-table-body" class="divide-y divide-slate-100">
                            <!-- JS Dynamically rendered rows -->
                        </tbody>
                    </table>
                </div>

                <!-- Empty State for List -->
                <div id="empty-state-list" class="hidden text-center py-12">
                    <p class="text-slate-500">目前沒有找到相關單字。</p>
                </div>
            </div>
        </section>

    </main>

    <!-- Modal for Add/Edit Word -->
    <div id="card-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white rounded-2xl shadow-xl max-w-md w-full overflow-hidden transform transition-all">
            <div class="bg-indigo-600 text-white px-6 py-4 flex justify-between items-center">
                <h3 id="modal-title" class="font-bold text-lg">新增單字卡</h3>
                <button id="btn-close-modal" class="text-indigo-200 hover:text-white text-lg">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="card-form" class="p-6 space-y-4">
                <input type="hidden" id="form-card-id">

                <div class="grid grid-cols-3 gap-3">
                    <div class="col-span-2">
                        <label class="block text-xs font-semibold text-slate-600 mb-1">英文單字 *</label>
                        <input type="text" id="form-word" required placeholder="e.g., Resilience" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 mb-1">詞性 *</label>
                        <select id="form-pos" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none bg-white">
                            <option value="n.">n. 名詞</option>
                            <option value="v.">v. 動詞</option>
                            <option value="adj.">adj. 形容詞</option>
                            <option value="adv.">adv. 副詞</option>
                            <option value="prep.">prep. 介系詞</option>
                            <option value="conj.">conj. 連接詞</option>
                            <option value="phr.">phr. 片語</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">中文翻譯 *</label>
                    <input type="text" id="form-translation" required placeholder="例如：韌性、彈性" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">分類標籤</label>
                    <input type="text" id="form-category" placeholder="例如：Work, Daily, Academic" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">英文例句</label>
                    <textarea id="form-example" rows="2" placeholder="e.g., Her resilience helped her overcome difficulties." class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none"></textarea>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 mb-1">例句中譯</label>
                    <textarea id="form-example-trans" rows="2" placeholder="例如：她的韌性幫助她克服了困難。" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:outline-none resize-none"></textarea>
                </div>

                <div class="flex justify-end space-x-2 pt-2 border-t border-slate-100">
                    <button type="button" id="btn-cancel-modal" class="px-4 py-2 border border-slate-200 rounded-lg text-sm text-slate-600 hover:bg-slate-50 font-medium transition">取消</button>
                    <button type="submit" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-sm font-semibold shadow-sm transition">儲存</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript Application Logic -->
    <script>
        // Initial Default Vocabulary Data
        const DEFAULT_CARDS = [
            {
                id: '1',
                word: 'Persistent',
                pos: 'adj.',
                translation: '堅持不懈的、持續的',
                category: 'Personality',
                example: 'She was persistent in chasing her dreams despite facing many obstacles.',
                exampleTrans: '儘管遇到許多障礙，她依然堅持不懈地追求夢想。',
                mastered: false,
                createdAt: Date.now() - 500000
            },
            {
                id: '2',
                word: 'Collaborate',
                pos: 'v.',
                translation: '合作、協同工作',
                category: 'Work',
                example: 'Teams from different departments collaborated on the new project.',
                exampleTrans: '來自不同部門的團隊在這個新專案上展開了合作。',
                mastered: true,
                createdAt: Date.now() - 400000
            },
            {
                id: '3',
                word: 'Aesthetic',
                pos: 'adj.',
                translation: '美學的、審美的',
                category: 'Design',
                example: 'The building was designed with both functionality and aesthetic appeal in mind.',
                exampleTrans: '這座建築設計時兼顧了實用性與美學吸引力。',
                mastered: false,
                createdAt: Date.now() - 300000
            },
            {
                id: '4',
                word: 'Pragmatic',
                pos: 'adj.',
                translation: '務實的、重實效的',
                category: 'Philosophy',
                example: 'We need a pragmatic approach to solve this complicated issue.',
                exampleTrans: '我們需要一種務實的方法來解決這個複雜的問題。',
                mastered: false,
                createdAt: Date.now() - 200000
            }
        ];

        // App State
        let cards = [];
        let currentIndex = 0;
        let isFlipped = false;
        let currentView = 'practice'; // 'practice' or 'list'

        // DOM Elements
        const flashcard = document.getElementById('flashcard');
        const flashcardInner = document.getElementById('flashcard-inner');
        const viewPractice = document.getElementById('view-practice');
        const viewList = document.getElementById('view-list');
        const cardModal = document.getElementById('card-modal');
        const cardForm = document.getElementById('card-form');

        // Initialize App
        function initApp() {
            loadCards();
            setupEventListeners();
            updateCategoryFilterOptions();
            renderView();
        }

        // Load cards from LocalStorage or Default
        function loadCards() {
            const savedCards = localStorage.getItem('flashcards_data');
            if (savedCards) {
                try {
                    cards = JSON.parse(savedCards);
                } catch(e) {
                    cards = [...DEFAULT_CARDS];
                }
            } else {
                cards = [...DEFAULT_CARDS];
                saveCards();
            }
        }

        // Save cards to LocalStorage
        function saveCards() {
            localStorage.setItem('flashcards_data', JSON.stringify(cards));
            updateCategoryFilterOptions();
        }

        // Get Filtered Cards based on UI Selectors
        function getFilteredCards() {
            const statusFilter = document.getElementById('filter-status').value;
            const categoryFilter = document.getElementById('filter-category').value;
            const searchQuery = document.getElementById('search-input').value.toLowerCase().trim();

            return cards.filter(card => {
                // Status Filter
                if (statusFilter === 'mastered' && !card.mastered) return false;
                if (statusFilter === 'review' && card.mastered) return false;

                // Category Filter
                if (categoryFilter !== 'all' && card.category !== categoryFilter) return false;

                // Search Filter
                if (searchQuery) {
                    const matchWord = card.word.toLowerCase().includes(searchQuery);
                    const matchTrans = card.translation.toLowerCase().includes(searchQuery);
                    const matchEx = card.example ? card.example.toLowerCase().includes(searchQuery) : false;
                    if (!matchWord && !matchTrans && !matchEx) return false;
                }

                return true;
            });
        }

        // Update Category Select Dropdown
        function updateCategoryFilterOptions() {
            const categorySelect = document.getElementById('filter-category');
            const currentValue = categorySelect.value;
            
            // Extract Unique Categories
            const categories = Array.from(new Set(cards.map(c => c.category || 'General').filter(Boolean)));
            
            categorySelect.innerHTML = '<option value="all">所有分類</option>';
            categories.forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat;
                opt.textContent = cat;
                categorySelect.appendChild(opt);
            });

            categorySelect.value = categories.includes(currentValue) ? currentValue : 'all';
        }

        // Render Practice View (Flashcard)
        function renderPracticeView() {
            const filteredCards = getFilteredCards();
            const emptyState = document.getElementById('empty-state-practice');

            if (filteredCards.length === 0) {
                flashcard.classList.add('hidden');
                document.getElementById('btn-prev').disabled = true;
                document.getElementById('btn-next').disabled = true;
                document.getElementById('btn-toggle-mastered').classList.add('hidden');
                document.getElementById('card-counter').textContent = '0 / 0';
                document.getElementById('progress-bar').style.width = '0%';
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');
            flashcard.classList.remove('hidden');
            document.getElementById('btn-toggle-mastered').classList.remove('hidden');

            // Boundaries Check
            if (currentIndex >= filteredCards.length) currentIndex = filteredCards.length - 1;
            if (currentIndex < 0) currentIndex = 0;

            const card = filteredCards[currentIndex];

            // Reset Flip State when updating content
            if (isFlipped) {
                isFlipped = false;
                flashcardInner.classList.remove('rotate-y-180');
            }

            // Populate Front
            document.getElementById('card-word').textContent = card.word;
            document.getElementById('card-pos').textContent = card.pos || '';
            document.getElementById('card-category-front').textContent = card.category || 'General';

            // Populate Back
            document.getElementById('card-pos-back').textContent = card.pos || '';
            document.getElementById('card-translation').textContent = card.translation;
            document.getElementById('card-example').textContent = card.example ? `"${card.example}"` : '（無例句）';
            document.getElementById('card-example-trans').textContent = card.exampleTrans || '';
            document.getElementById('card-category-back').textContent = card.category || 'General';

            // Progress & Counter
            document.getElementById('card-counter').textContent = `${currentIndex + 1} / ${filteredCards.length}`;
            const progressPercent = ((currentIndex + 1) / filteredCards.length) * 100;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;

            // Status Badge
            const statusBadge = document.getElementById('card-status-badge');
            const masteredBtn = document.getElementById('btn-toggle-mastered');
            const masteredIcon = document.getElementById('mastered-icon');
            const masteredText = document.getElementById('mastered-text');

            if (card.mastered) {
                statusBadge.textContent = '已掌握';
                statusBadge.className = 'px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800';
                
                masteredBtn.className = 'px-4 py-2.5 bg-emerald-600 text-white border border-emerald-600 rounded-xl text-sm font-semibold transition flex items-center space-x-1.5 shadow-sm hover:bg-emerald-700';
                masteredIcon.className = 'fa-solid fa-circle-check text-base';
                masteredText.textContent = '已掌握';
            } else {
                statusBadge.textContent = '需複習';
                statusBadge.className = 'px-2 py-0.5 rounded text-xs font-semibold bg-amber-100 text-amber-800';
                
                masteredBtn.className = 'px-4 py-2.5 bg-white text-slate-700 border border-slate-200 rounded-xl text-sm font-semibold transition flex items-center space-x-1.5 shadow-sm hover:bg-slate-50';
                masteredIcon.className = 'fa-regular fa-circle-check text-base text-slate-400';
                masteredText.textContent = '標記為已掌握';
            }
        }

        // Render List View
        function renderListView() {
            const filteredCards = getFilteredCards();
            const tbody = document.getElementById('words-table-body');
            const emptyState = document.getElementById('empty-state-list');

            tbody.innerHTML = '';

            if (filteredCards.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            }

            emptyState.classList.add('hidden');

            filteredCards.forEach(card => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-50/80 transition text-slate-700';

                tr.innerHTML = `
                    <td class="p-3.5">
                        <button onclick="toggleCardMastery('${card.id}')" class="focus:outline-none">
                            ${card.mastered 
                                ? '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-800"><i class="fa-solid fa-check me-1"></i>已掌握</span>' 
                                : '<span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800"><i class="fa-solid fa-clock me-1"></i>需複習</span>'}
                        </button>
                    </td>
                    <td class="p-3.5 font-medium text-slate-900">
                        ${escapeHtml(card.word)} <span class="text-xs text-indigo-500 font-serif">${escapeHtml(card.pos || '')}</span>
                    </td>
                    <td class="p-3.5 font-medium text-indigo-900">${escapeHtml(card.translation)}</td>
                    <td class="p-3.5">
                        <span class="inline-block bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-xs">${escapeHtml(card.category || 'General')}</span>
                    </td>
                    <td class="p-3.5 text-xs text-slate-500 max-w-xs truncate hidden md:table-cell" title="${escapeHtml(card.example || '')}">
                        ${escapeHtml(card.example || '-')}
                    </td>
                    <td class="p-3.5 text-right space-x-2">
                        <button onclick="openEditModal('${card.id}')" class="text-slate-400 hover:text-indigo-600 transition p-1" title="編輯">
                            <i class="fa-solid fa-pen"></i>
                        </button>
                        <button onclick="deleteCard('${card.id}')" class="text-slate-400 hover:text-rose-600 transition p-1" title="刪除">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Render active view
        function renderView() {
            if (currentView === 'practice') {
                viewPractice.classList.remove('hidden');
                viewPractice.classList.add('flex');
                viewList.classList.add('hidden');
                renderPracticeView();
            } else {
                viewList.classList.remove('hidden');
                viewPractice.classList.add('hidden');
                viewPractice.classList.remove('flex');
                renderListView();
            }
        }

        // Text-to-Speech (TTS)
        function speakText(text) {
            if (!('speechSynthesis' in window)) {
                alert('您的瀏覽器不支援語音朗讀功能');
                return;
            }
            window.speechSynthesis.cancel(); // Stop current speech
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = 0.9;
            window.speechSynthesis.speak(utterance);
        }

        // Event Listeners Setup
        function setupEventListeners() {
            // Flip Flashcard
            flashcard.addEventListener('click', (e) => {
                // Prevent flip when clicking action buttons inside card
                if (e.target.closest('button')) return;
                isFlipped = !isFlipped;
                flashcardInner.classList.toggle('rotate-y-180', isFlipped);
            });

            // Card Speak Buttons
            document.getElementById('btn-speak-word').addEventListener('click', (e) => {
                e.stopPropagation();
                const filtered = getFilteredCards();
                if (filtered[currentIndex]) speakText(filtered[currentIndex].word);
            });

            document.getElementById('btn-speak-example').addEventListener('click', (e) => {
                e.stopPropagation();
                const filtered = getFilteredCards();
                if (filtered[currentIndex] && filtered[currentIndex].example) {
                    speakText(filtered[currentIndex].example);
                }
            });

            // Navigation
            document.getElementById('btn-prev').addEventListener('click', () => {
                const filtered = getFilteredCards();
                if (filtered.length === 0) return;
                currentIndex = (currentIndex - 1 + filtered.length) % filtered.length;
                renderPracticeView();
            });

            document.getElementById('btn-next').addEventListener('click', () => {
                const filtered = getFilteredCards();
                if (filtered.length === 0) return;
                currentIndex = (currentIndex + 1) % filtered.length;
                renderPracticeView();
            });

            // Toggle Mastery in Practice Mode
            document.getElementById('btn-toggle-mastered').addEventListener('click', () => {
                const filtered = getFilteredCards();
                if (filtered.length === 0) return;
                const currentCard = filtered[currentIndex];
                toggleCardMastery(currentCard.id);
            });

            // View Mode Switching
            document.getElementById('btn-practice-mode').addEventListener('click', () => {
                currentView = 'practice';
                document.getElementById('btn-practice-mode').className = "bg-indigo-700 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1 shadow-sm";
                document.getElementById('btn-list-mode').className = "bg-indigo-500/50 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1";
                renderView();
            });

            document.getElementById('btn-list-mode').addEventListener('click', () => {
                currentView = 'list';
                document.getElementById('btn-list-mode').className = "bg-indigo-700 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1 shadow-sm";
                document.getElementById('btn-practice-mode').className = "bg-indigo-500/50 hover:bg-indigo-500 text-white px-3 py-1.5 rounded-lg text-sm font-medium transition flex items-center space-x-1";
                renderView();
            });

            // Filters & Search
            document.getElementById('filter-status').addEventListener('change', () => {
                currentIndex = 0;
                renderView();
            });

            document.getElementById('filter-category').addEventListener('change', () => {
                currentIndex = 0;
                renderView();
            });

            document.getElementById('search-input').addEventListener('input', () => {
                currentIndex = 0;
                renderView();
            });

            // Modal Controls
            document.getElementById('btn-add-card').addEventListener('click', () => openAddModal());
            document.getElementById('btn-close-modal').addEventListener('click', closeModal);
            document.getElementById('btn-cancel-modal').addEventListener('click', closeModal);

            // Form Submit
            cardForm.addEventListener('submit', (e) => {
                e.preventDefault();
                const id = document.getElementById('form-card-id').value;
                const wordData = {
                    word: document.getElementById('form-word').value.trim(),
                    pos: document.getElementById('form-pos').value,
                    translation: document.getElementById('form-translation').value.trim(),
                    category: document.getElementById('form-category').value.trim() || 'General',
                    example: document.getElementById('form-example').value.trim(),
                    exampleTrans: document.getElementById('form-example-trans').value.trim()
                };

                if (id) {
                    // Update Existing Card
                    const index = cards.findIndex(c => c.id === id);
                    if (index !== -1) {
                        cards[index] = { ...cards[index], ...wordData };
                    }
                } else {
                    // Create New Card
                    const newCard = {
                        id: Date.now().toString(),
                        ...wordData,
                        mastered: false,
                        createdAt: Date.now()
                    };
                    cards.unshift(newCard);
                    currentIndex = 0;
                }

                saveCards();
                closeModal();
                renderView();
            });

            // Keyboard Navigation Shortcuts
            document.addEventListener('keydown', (e) => {
                // Ignore if modal is open or typing in input
                if (!cardModal.classList.contains('hidden') || ['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement.tagName)) {
                    return;
                }

                if (currentView === 'practice') {
                    if (e.code === 'Space') {
                        e.preventDefault();
                        isFlipped = !isFlipped;
                        flashcardInner.classList.toggle('rotate-y-180', isFlipped);
                    } else if (e.code === 'ArrowRight') {
                        document.getElementById('btn-next').click();
                    } else if (e.code === 'ArrowLeft') {
                        document.getElementById('btn-prev').click();
                    }
                }
            });

            // Backup & Export JSON
            document.getElementById('btn-export').addEventListener('click', () => {
                const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(cards, null, 2));
                const downloadAnchor = document.createElement('a');
                downloadAnchor.setAttribute("href", dataStr);
                downloadAnchor.setAttribute("download", `flashcards_backup_${new Date().toISOString().slice(0,10)}.json`);
                document.body.appendChild(downloadAnchor);
                downloadAnchor.click();
                downloadAnchor.remove();
            });

            // Import JSON
            document.getElementById('import-file').addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (!file) return;

                const reader = new FileReader();
                reader.onload = function(event) {
                    try {
                        const importedData = JSON.parse(event.target.result);
                        if (Array.isArray(importedData)) {
                            cards = importedData;
                            saveCards();
                            renderView();
                            alert('成功匯入單字庫！');
                        } else {
                            alert('格式錯誤：無效的 JSON 單字資料');
                        }
                    } catch (err) {
                        alert('無法解析檔案，請確認內容為標準 JSON 格式');
                    }
                };
                reader.readAsText(file);
            });
        }

        // Toggle Single Card Mastery State
        window.toggleCardMastery = function(id) {
            const card = cards.find(c => c.id === id);
            if (card) {
                card.mastered = !card.mastered;
                saveCards();
                renderView();
            }
        };

        // Modal Open/Close Handlers
        function openAddModal() {
            document.getElementById('modal-title').textContent = '新增單字卡';
            document.getElementById('form-card-id').value = '';
            cardForm.reset();
            cardModal.classList.remove('hidden');
        }

        window.openEditModal = function(id) {
            const card = cards.find(c => c.id === id);
            if (!card) return;

            document.getElementById('modal-title').textContent = '編輯單字卡';
            document.getElementById('form-card-id').value = card.id;
            document.getElementById('form-word').value = card.word;
            document.getElementById('form-pos').value = card.pos || 'n.';
            document.getElementById('form-translation').value = card.translation;
            document.getElementById('form-category').value = card.category || '';
            document.getElementById('form-example').value = card.example || '';
            document.getElementById('form-example-trans').value = card.exampleTrans || '';

            cardModal.classList.remove('hidden');
        };

        function closeModal() {
            cardModal.classList.add('hidden');
        }

        // Delete Card
        window.deleteCard = function(id) {
            if (confirm('確定要刪除這個單字卡嗎？')) {
                cards = cards.filter(c => c.id !== id);
                saveCards();
                renderView();
            }
        };

        // Utility: Escape HTML
        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        // Launch
        document.addEventListener('DOMContentLoaded', initApp);
    </script>
</body>
</html>
